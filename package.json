{
  "name": "gameday-plus-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Background sync service for GameDay+ athletic events from an iCal feed.",
  "main": "services/ical-sync.js",
  "scripts": {
    "sync:ical": "node services/ical-sync.js",
    "sync:ical:once": "node services/ical-sync.js --once",
    "seed:firestore": "node services/seed-firestore.js",
    "seed:all": "node services/seed-all-schools.js",
    "set-admin": "node services/set-claims.js",
    "notify": "node services/send-notifications.js",
    "notify:drain": "node services/send-notifications.js --drain",
    "notify:watch": "node services/notify-watcher.js",
    "ai:describe": "node services/generate-description.js",
    "ai:describe:openrouter": "node services/generate-description.js --provider openrouter",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:rules": "node --test \"tests/rules/**/*.test.js\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.0.0",
    "node-cron": "^3.0.3",
    "node-ical": "^0.20.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.29.1",
    "jsdom": "^24.1.3"
  }
}

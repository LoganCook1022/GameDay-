ICAL_FEED_URL=https://example.com/athletics.ics
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase Cloud Messaging (web push)
# Web Push certificate key pair from Firebase Console > Project settings > Cloud Messaging.
# Paste the public key into assets/js/firebase-config.js (window.GAMEDAY_FCM_VAPID_KEY).
GAMEDAY_FCM_VAPID_KEY=your_web_push_vapid_public_key
FIREBASE_SERVICE_ACCOUNT=c:\path\to\serviceAccountKey.json

# AI event description generator (OpenAI-compatible; Groq default, OpenRouter fallback)
# Google AI Studio is blocked for our school Workspace account, so we use Groq.
#   node services/generate-description.js
GAMEDAY_AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GAMEDAY_AI_MODEL=
GAMEDAY_AI_PORT=8787
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gameday
DB_USER=gameday
DB_PASSWORD=secret
